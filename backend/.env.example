APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# On production this MUST be `.tripinele.com` (leading dot), not null — real bug found
# 2026-08-11: with SESSION_DOMAIN=null the session cookie is host-only, so a Google OAuth flow
# started on www.tripinele.com sets a cookie www can see but tripinele.com (the hardcoded
# redirect_uri) can't, and Socialite throws InvalidStateException on every callback. Confirmed
# fixed via a curl repro (session from www host replayed against the non-www callback).
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# GPT-4o-mini, used by the Honest Report AI feature — see wizard_architecture memory.
OPENAI_API_KEY=

# Google OAuth login — see CLAUDE.md section 5/8. Create at
# https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, type "Web
# application"), authorized redirect URI: {APP_URL}/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed where frontend/backend run on different ports (local dev) — see config/app.php.
# FRONTEND_URL=http://127.0.0.1:4837

# Booking.com DACH affiliate program via CJ — see CLAUDE.md section 8 and config/services.php's
# 'cj' block docblock. Real values live only in production's .env (not committed) — without
# these, toBookingUrl()/toBookingFlightsUrl() still work, just unwrapped/untracked.
CJ_AFFILIATE_PID=
CJ_AFFILIATE_LINK_ID=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
